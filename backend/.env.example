# Variables del backend (desarrollo local). En Azure se inyectan por Bicep + Managed Identity.
# Sin claves: la autenticación es por Entra ID / DefaultAzureCredential.

# Azure AI Services (Foundry). Dejar vacío => el pipeline usa su heurística de respaldo.
AI_SERVICES_ENDPOINT=
AI_INFERENCE_ENDPOINT=
OPENAI_API_VERSION=2024-10-21

# Deployment names
DEPLOY_CLASSIFY=gpt-4o
DEPLOY_COMPETENCE=mai-thinking-1
DEPLOY_DRAFT=mai-thinking-1
DEPLOY_EMBEDDINGS=text-embedding-3-large

# Azure AI Search
SEARCH_ENDPOINT=
SEARCH_INDEX=reglas-idx

# Storage (Tables + Blob). Vacío => almacén en memoria.
STORAGE_ACCOUNT=

# Umbral de confianza para derivación a revisión manual
CONFIANZA_MIN=70

CORS_ORIGINS=*
